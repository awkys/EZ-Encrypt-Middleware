# 1. ─────────────────────────── 基础服务器设置 ───────────────────────────
PORT=3000                                  # 服务器监听端口
BACKEND_API_URL=https://api.example.com    # 后端真实 API 根地址不带 /api/v1（无尾斜杠）
PATH_PREFIX=/ez/example                    # 路径前缀，为空""则处理所有路径，否则只处理匹配前缀的路径

# 2. ─────────────────────────── CORS / 安全设置 ──────────────────────────
CORS_ORIGIN=*                              # 允许的 CORS 源；* 表示全部
ALLOWED_ORIGINS=*                          # 请求来源白名单，逗号分隔或 * 通配
REQUEST_TIMEOUT=30000                      # 请求超时(ms)
ENABLE_LOGGING=false                       # 是否输出请求日志
DEBUG_MODE=false                           # 是否输出调试日志

# 3. ────────────────────────── 支付回调免验证路径 ────────────────────────
# 多条用英文逗号分隔，须写完整路径（含前缀）,管理员面板有地址
# 例如: /api/v1/guest/payment/notify/EPay/12345, /api/v1/guest/payment/notify/Alipay/ABC123
ALLOWED_PAYMENT_NOTIFY_PATHS=/api/v1/guest/payment/notify/EPay/example

# 5. ────────────────────────── AES 加解密配置 ───────────────────────────
# 中间件加密KEY必须是16位的16进制字符串，必须和前端key保持一致 在线生成地址 https://www.bejson.com/math/hex_gen/
AES_KEY=your_16_char_hex_key_here

# 6. ────────────────────────── OSS 订阅分发配置 ───────────────────────────
OSS_ENABLED=true                           # 开启 OSS

# 阿里云 OSS 配置示例
# 1. Endpoint: 登录 OSS 控制台查看 (例如: https://oss-cn-shanghai.aliyuncs.com)
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# 2. Region: 从 Endpoint 提取 (例如: cn-shanghai)
OSS_REGION=cn-shanghai

# 3. AccessKey: 阿里云 AccessKey 管理获取
OSS_ACCESS_KEY=your_access_key_id
OSS_SECRET_KEY=your_access_key_secret

# 4. Bucket: 你的 Bucket 名称
OSS_BUCKET=your_bucket_name

# 5. Domain: 如果没有CDN，直接使用 Bucket 域名
# 格式: https://<BucketName>.<Region>.aliyuncs.com
# 例如: https://my-sub-bucket.oss-cn-shanghai.aliyuncs.com
OSS_CDN_DOMAIN=https://your-bucket.oss-cn-shanghai.aliyuncs.com
